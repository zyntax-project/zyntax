// Free-function call latency, against the inlined baseline in
// `bench_inlined_call.zynml`.
//
// The loop body is one call to a top-level `def` doing arithmetic the
// baseline does inline, so the delta between the two kernels is the
// per-call cost that survives the pipeline. `step` is small and pure,
// which is exactly what the inliner takes, so the delta is expected to
// be near zero: the number says the call was removed, not that calls
// are free.
//
// The accumulator steps by `i % 8` for the reason the baseline gives:
// a constant step leaves an affine recurrence the pipeline folds to a
// closed form, and both kernels then measure nothing.
//
// Returns the same 350000000 the baseline does.

def step(acc: i64, i: i64): i64 {
    return acc + (i % 8)
}

def main(): i64 {
    let mut sum: i64 = 0
    let mut i: i64 = 0
    while i < 100000000 {
        sum = step(sum, i)
        i = i + 1
    }
    return sum
}
