import prelude

// Mandelbrot bench — exact port of rayzor's
// `compiler/benchmarks/haxe/BMMandelbrotCode.hx`, which itself is
// the HaxeBenchmarks reference Mandelbrot. The checksum is the
// sum of `palette[iteration].r + .g + .b` across an 875 × 500 grid
// with the iteration counted from `z = z² + c` (Mandelbrot's
// quadratic recurrence) capped at 1000 with an escape radius² of
// 65 536. Matching against rayzor exercises ZynML's:
//   * `scale = 0.1 / SIZE` float-literal arithmetic
//   * `(x as f64) * scale - 2.5` integer-to-float casts
//   * f64-arg helper functions
//   * float-heavy recursive-quadratic inner loop
//
// Reference checksum (rayzor + HashLink): **112_798_515**.
//
// Checksums, all measured:
//   ZYNTAX_DISABLE_FMA=1        112790102
//   C, -ffp-contract=off        112790102   <- the same, to the digit
//   FMA on (what this expects)  112789639
//   C, -ffp-contract=fast       112798802
//   rayzor + HashLink           112798515
//
// With contraction off this computes exactly what a C compiler
// computes for the same source under strict IEEE, so the float
// path is right and the remaining 8413 between it and rayzor is
// not rounding introduced here. Whatever it is lives in the port
// against rayzor's complexSquare/complexAdd formulation, or in
// rayzor's own arithmetic, and it is unexplained.
//
// Contraction is the only thing in the pipeline that moves this
// number: disabling it alone reproduces the fully unoptimised
// checksum, while LICM, CSE, inlining and vectorisation are all
// bit-exact on this kernel.
//
// What gets fused is exactly one product, `2*zx*zy + cy`. Fusing
// only that in C reproduces 112789639 to the digit. Fusing across
// the assignments of zx2 and zy2 as well, which would un-round a
// value that was already stored, gives 112790103 / 112790126 /
// 112790252 and matches nothing here. So the contraction stays
// inside a single expression, which is the rule a C compiler
// follows. C at -ffp-contract=fast reaches further and lands on
// 112798802.

def palette_sum(iteration: i64, max_iter: i64): i64 {
    let fraction: f64 = (iteration as f64) / (max_iter as f64)
    let r: i64 = (fraction * 255.0) as i64
    let g: i64 = ((1.0 - fraction) * 255.0) as i64
    let b: i64 = ((0.5 - abs(fraction - 0.5)) * 2.0 * 255.0) as i64
    return r + g + b
}

def main(): i64 {
    let size: i64 = 25
    let max_iter: i64 = 1000
    let max_rad: f64 = 65536.0
    let width: i64 = 35 * size
    let height: i64 = 20 * size
    let scale: f64 = 0.004

    let mut checksum: i64 = 0
    let mut y: i64 = 0
    while y < height {
        let mut x: i64 = 0
        while x < width {
            let cx: f64 = (x as f64) * scale - 2.5
            let cy: f64 = (y as f64) * scale - 1.0
            let mut zx: f64 = 0.0
            let mut zy: f64 = 0.0
            let mut zx2: f64 = 0.0
            let mut zy2: f64 = 0.0
            let mut iter: i64 = 0
            while iter < max_iter {
                if zx2 + zy2 >= max_rad {
                    break
                }
                let new_zx: f64 = zx2 - zy2 + cx
                let new_zy: f64 = 2.0 * zx * zy + cy
                zx = new_zx
                zy = new_zy
                zx2 = zx * zx
                zy2 = zy * zy
                iter = iter + 1
            }
            checksum = checksum + palette_sum(iter, max_iter)
            x = x + 1
        }
        y = y + 1
    }
    return checksum
}
