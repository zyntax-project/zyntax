// Fibonacci bench — naive recursive Fibonacci, the classic
// function-call-overhead microbenchmark from the Computer
// Language Benchmarks Game lineage (used by wren_lift, rayzor,
// and the original `wren` repo too).
//
// `fib(n)` makes `O(φⁿ)` calls — roughly 4.7 million calls for
// `fib(30)`. That's the point: the bench measures function-call
// dispatch and return overhead, not arithmetic. If the dispatch
// is fast, the number drops; if it's slow, the number goes up
// and we know where to look.
//
// Returns `fib(30)` = 832040.

def fib(n: i64): i64 {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

def main(): i64 {
    return fib(30)
}
