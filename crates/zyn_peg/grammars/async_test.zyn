// ===================================================================
// Async Test Language Grammar
// ===================================================================
//
// A minimal language designed to test async/await parsing in the
// Zyntax runtime. Uses the same construct-style action syntax as
// `ml.zyn` so the Grammar2 packrat interpreter can execute it
// directly (the prior version of this file used legacy JSON actions
// which the new interpreter rejects with
// "legacy JSON action … requires code generation").
//
// Surface syntax (C-style with `;` terminators):
//   fn name(params) ReturnType { body }
//   async fn name(params) ReturnType { body }
//   const x: T = expr;   var x: T = expr;
//   return expr;         if (cond) { ... } else { ... }
//   while (cond) { ... } x = expr;
//   await call_expr
//
// ===================================================================

@language {
    name: "AsyncTest",
    version: "0.2",
    file_extensions: [".async", ".at"],
    entry_point: "main",
}

// ===== Program Structure =====

program = { SOI ~ items:program_items ~ EOI }
  -> items

program_items = { decls:declaration* }
  -> TypedProgram {
      declarations: decls,
  }

declaration = { async_fn_decl | fn_decl }

// ===== Async Function Declaration =====
// async fn name(params) return_type { body }

async_fn_decl = { async_fn_with_params | async_fn_no_params }

async_fn_with_params = { "async" ~ "fn" ~ name:identifier ~ "(" ~ params:fn_params ~ ")" ~ ret:type_expr ~ body:block }
  -> TypedDeclaration::Function {
      name: intern(name),
      params: params,
      return_type: ret,
      body: Some(body),
      is_async: true,
  }

async_fn_no_params = { "async" ~ "fn" ~ name:identifier ~ "(" ~ ")" ~ ret:type_expr ~ body:block }
  -> TypedDeclaration::Function {
      name: intern(name),
      params: [],
      return_type: ret,
      body: Some(body),
      is_async: true,
  }

// ===== Regular Function Declaration =====

fn_decl = { fn_with_params | fn_no_params }

fn_with_params = { "fn" ~ name:identifier ~ "(" ~ params:fn_params ~ ")" ~ ret:type_expr ~ body:block }
  -> TypedDeclaration::Function {
      name: intern(name),
      params: params,
      return_type: ret,
      body: Some(body),
  }

fn_no_params = { "fn" ~ name:identifier ~ "(" ~ ")" ~ ret:type_expr ~ body:block }
  -> TypedDeclaration::Function {
      name: intern(name),
      params: [],
      return_type: ret,
      body: Some(body),
  }

// ===== Function Parameters =====

fn_params = { first:fn_param ~ rest:fn_param_comma* }
  -> prepend_list(first, rest)

fn_param_comma = { "," ~ p:fn_param }
  -> p

fn_param = { name:identifier ~ ":" ~ ty:type_expr }
  -> TypedParameter {
      name: intern(name),
      ty: ty,
  }

// ===== Type Expressions =====

type_expr = { promise_type | optional_type | primitive_type | named_type }

// Promise<T>
promise_type = { "Promise" ~ "<" ~ inner:type_expr ~ ">" }
  -> Type::Named {
      name: intern("Promise"),
      args: [inner],
  }

// ?T
optional_type = { "?" ~ inner:type_expr }
  -> Type::Named {
      name: intern("Option"),
      args: [inner],
  }

primitive_type = { ty:primitive_keyword }
  -> Type::Primitive {
      name: ty,
  }

primitive_keyword = @{ "i32" | "i64" | "u32" | "u64" | "f32" | "f64" | "bool" | "void" }

named_type = { name:identifier }
  -> Type::Named {
      name: intern(name),
      args: [],
  }

// ===== Block + Statements =====

block = { "{" ~ stmts:statement* ~ "}" }
  -> TypedBlock {
      statements: stmts,
  }

statement = { return_stmt | if_stmt | while_stmt | var_stmt | const_stmt | assign_stmt | expr_stmt }

// return [expr] ;
return_stmt = { "return" ~ value:expr? ~ ";" }
  -> TypedStatement::Return {
      value: value,
  }

// if (cond) { then } [else { else }]
if_stmt = { if_else_stmt | if_simple_stmt }

if_else_stmt = { "if" ~ "(" ~ cond:expr ~ ")" ~ then_body:block ~ "else" ~ else_body:block }
  -> TypedStatement::If {
      condition: cond,
      then_branch: then_body,
      else_branch: else_body,
  }

if_simple_stmt = { "if" ~ "(" ~ cond:expr ~ ")" ~ then_body:block }
  -> TypedStatement::If {
      condition: cond,
      then_branch: then_body,
      else_branch: None,
  }

// while (cond) { body }
while_stmt = { "while" ~ "(" ~ cond:expr ~ ")" ~ body:block }
  -> TypedStatement::While {
      condition: cond,
      body: body,
  }

// var x [: T] = expr ;
var_stmt = { var_typed_stmt | var_untyped_stmt }

var_typed_stmt = { "var" ~ name:identifier ~ ":" ~ ty:type_expr ~ "=" ~ init:expr ~ ";" }
  -> TypedStatement::Let {
      name: intern(name),
      type_annotation: Some(ty),
      initializer: Some(init),
      is_mutable: true,
  }

var_untyped_stmt = { "var" ~ name:identifier ~ "=" ~ init:expr ~ ";" }
  -> TypedStatement::Let {
      name: intern(name),
      type_annotation: None,
      initializer: Some(init),
      is_mutable: true,
  }

// const x [: T] = expr ;
const_stmt = { const_typed_stmt | const_untyped_stmt }

const_typed_stmt = { "const" ~ name:identifier ~ ":" ~ ty:type_expr ~ "=" ~ init:expr ~ ";" }
  -> TypedStatement::Let {
      name: intern(name),
      type_annotation: Some(ty),
      initializer: Some(init),
      is_mutable: false,
  }

const_untyped_stmt = { "const" ~ name:identifier ~ "=" ~ init:expr ~ ";" }
  -> TypedStatement::Let {
      name: intern(name),
      type_annotation: None,
      initializer: Some(init),
      is_mutable: false,
  }

// x = expr ;   (simple assignment only — full lvalue support not needed for these tests)
assign_stmt = { target:identifier ~ "=" ~ value:expr ~ ";" }
  -> TypedStatement::Assignment {
      target: TypedExpression::Variable { name: intern(target) },
      value: value,
  }

// expr ;
expr_stmt = { e:expr ~ ";" }
  -> TypedStatement::Expression {
      expr: e,
  }

// ===== Expressions =====
// await is at the unary level, so `await foo()` parses but `await x + 1`
// is await(x) + 1 (matches ml.zyn convention).

expr = { e:comparison_expr }
  -> e

// Comparisons (left-assoc)
comparison_expr = { first:additive_expr ~ rest:comparison_rest* }
  -> fold_left_ops(first, rest)

comparison_rest = { op:comparison_op ~ operand:additive_expr }
  -> make_pair(op, operand)

comparison_op = @{ "==" | "!=" | "<=" | ">=" | "<" | ">" }

// Addition / subtraction (left-assoc)
additive_expr = { first:multiplicative_expr ~ rest:additive_rest* }
  -> fold_left_ops(first, rest)

additive_rest = { op:additive_op ~ operand:multiplicative_expr }
  -> make_pair(op, operand)

additive_op = @{ "+" | "-" }

// Multiplication / division / modulo (left-assoc)
multiplicative_expr = { first:unary_expr ~ rest:multiplicative_rest* }
  -> fold_left_ops(first, rest)

multiplicative_rest = { op:multiplicative_op ~ operand:unary_expr }
  -> make_pair(op, operand)

multiplicative_op = @{ "*" | "/" | "%" }

// Unary (await sits at this level so `const r = await foo()` parses)
unary_expr = { await_expr | unary_neg | unary_not | call_expr }

await_expr = { "await" ~ operand:call_expr }
  -> TypedExpression::Await {
      operand: Box::new(operand),
  }

unary_neg = { "-" ~ operand:call_expr }
  -> TypedExpression::Unary {
      op: "Neg",
      operand: Box::new(operand),
  }

unary_not = { "!" ~ operand:call_expr }
  -> TypedExpression::Unary {
      op: "Not",
      operand: Box::new(operand),
  }

// Call expression: primary [ "(" args ")" ]
call_expr = { call_with_args | primary_expr }

call_with_args = { callee:primary_expr ~ "(" ~ args:arg_list? ~ ")" }
  -> TypedExpression::Call {
      callee: Box::new(callee),
      args: args,
  }

arg_list = { first:expr ~ rest:arg_comma* }
  -> prepend_list(first, rest)

arg_comma = { "," ~ a:expr }
  -> a

// Primary
primary_expr = { grouped_expr | float_literal | int_literal | bool_literal | var_expr }

grouped_expr = { "(" ~ inner:expr ~ ")" }
  -> inner

var_expr = { name:identifier }
  -> TypedExpression::Variable {
      name: intern(name),
  }

int_literal = @{ "-"? ~ ASCII_DIGIT+ }
  -> TypedExpression::IntLiteral {
      value: parse_int(text()),
  }

float_literal = @{ "-"? ~ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ }
  -> TypedExpression::FloatLiteral {
      value: parse_float(text()),
  }

bool_literal = { "true" | "false" }
  -> TypedExpression::BoolLiteral {
      value: parse_bool(text()),
  }

// ===== Lexical Rules =====

identifier = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }

WHITESPACE = _{ " " | "\t" | "\n" | "\r" }
COMMENT = _{ "//" ~ (!"\n" ~ ANY)* | "/*" ~ (!"*/" ~ ANY)* ~ "*/" }
